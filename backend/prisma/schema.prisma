generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Document {
  id        String   @id
  title     String
  type      String
  date      DateTime
  version   String?
  service   String?
  content   String
  createdAt DateTime @default(now())

  evidence Evidence[]
}

model Investigation {
  id         String   @id @default(cuid())
  question   String
  summary    String?
  confidence String?
  createdAt  DateTime @default(now())

  evidence Evidence[]
}

model Evidence {
  id              String @id @default(cuid())
  investigationId String
  documentId      String
  reason          String?

  investigation Investigation @relation(fields: [investigationId], references: [id])
  document      Document      @relation(fields: [documentId], references: [id])
}